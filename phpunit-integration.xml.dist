<?xml version="1.0"?>
<!-- Integration tests: run against the WordPress test suite and a MySQL database. -->
<phpunit
    bootstrap="tests/integration/bootstrap.php"
    colors="true">
    <testsuites>
        <testsuite name="integration">
            <directory suffix="Test.php">tests/integration</directory>
        </testsuite>
    </testsuites>
</phpunit>
